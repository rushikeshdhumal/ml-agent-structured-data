# LLM (provider-agnostic via CrewAI's native provider routing). Examples:
#   MODEL=gpt-4o                 (requires OPENAI_API_KEY)
#   MODEL=anthropic/claude-sonnet-4-5-20250929   (requires ANTHROPIC_API_KEY)
#   MODEL=ollama/llama3          (requires a local Ollama server)
MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# For any OpenAI-compatible endpoint that isn't one of CrewAI's built-in named
# providers (e.g. NVIDIA's free NIM endpoints at build.nvidia.com), set
# LLM_BASE_URL + LLM_API_KEY instead -- crew.py then routes through CrewAI's
# native custom_openai path with the model id passed through unchanged. Example
# for NVIDIA's "z-ai/glm-5.2" model on the free tier (40 req/min):
#   MODEL=z-ai/glm-5.2
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_API_KEY=nvapi-...
#   MAX_RPM=35
LLM_BASE_URL=
LLM_API_KEY=

# Azure AI Foundry. Paste the endpoint from the Foundry portal in whatever form
# it shows (with or without a /models, /openai or /openai/v1 suffix) -- crew.py
# normalizes it to the OpenAI-compatible base URL. Takes precedence over
# LLM_BASE_URL, and needs no extra dependency: Foundry speaks the OpenAI
# protocol, so the provider CrewAI already ships natively handles it.
#
# MODEL is the piece people get wrong. For an Azure OpenAI deployment it is the
# DEPLOYMENT NAME you chose when deploying, not the model name; for a Foundry
# Models catalog deployment it is the model name. Examples:
#   MODEL=gpt-4o-ds-crew                      (Azure OpenAI, deployment name)
#   AZURE_FOUNDRY_ENDPOINT=https://my-res.openai.azure.com
#   MODEL=Llama-3.3-70B-Instruct              (Foundry Models, model name)
#   AZURE_FOUNDRY_ENDPOINT=https://my-res.services.ai.azure.com
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=

# Caps aggregate LLM calls/minute across the whole crew run (stay under a
# provider's rate limit). Leave unset for no cap.
MAX_RPM=

# Optional per-million-token rates for MODEL, used only to turn the token counts
# CrewAI reports into an estimated_cost_usd metric in MLflow. Leave BOTH unset
# on a free-tier endpoint: with no rates configured no cost metric is logged at
# all, which is honest, whereas a hardcoded 0.00 would be a claim. Token counts,
# request count and wall-clock are always recorded regardless.
#   e.g. LLM_PRICE_PER_1M_INPUT=0.15
#        LLM_PRICE_PER_1M_OUTPUT=0.60
LLM_PRICE_PER_1M_INPUT=
LLM_PRICE_PER_1M_OUTPUT=

# HTTP tool service (ds-crew-service). Gates run creation; creating a run mints a
# per-run token that every subsequent tool call must present, so an agent holding
# one run's token cannot reach another's data. The service refuses to start
# without this rather than defaulting to an open endpoint.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_KEY=

# MLflow tracking backend (local, serverless SQLite store)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=structured-ml-crew

# Human-in-the-loop bypass. Leave unset/0 for real runs; set to 1 only for
# automated/CI/headless runs. Every auto-approved run is tagged in MLflow.
AUTO_APPROVE=0

# Guardrail / budget caps
MAX_HPO_TRIALS=100
MAX_HPO_TIMEOUT_S=1800
NEAR_PERFECT_THRESHOLD=0.995
RANDOM_SEED=42

# Ensembling: hard cap on distinct member models (diminishing returns/rising
# weight-overfit risk beyond ~5 diverse tabular learners), the Optuna trial
# budget for weight optimization (cheap -- scores cached out-of-fold
# predictions, not refit models), and the minimum CV-metric margin an
# ensemble must beat the best single model by to be recommended over it.
MAX_ENSEMBLE_MEMBERS=5
ENSEMBLE_WEIGHT_TRIALS=60
MIN_ENSEMBLE_IMPROVEMENT=0.0

# Explainability: rows sampled from X_test before SHAP/permutation scoring,
# permutation-importance repeats (higher = tighter std, linearly more compute),
# how many engineered features are reported in detail, how many example rows
# per bucket (confident-correct / confident-wrong / most-uncertain) get a local
# explanation, and the depth of the surrogate decision tree whose fidelity
# tells you whether a simple story actually captures the model.
EXPLAIN_MAX_ROWS=500
EXPLAIN_PERMUTATION_REPEATS=10
EXPLAIN_TOP_K_FEATURES=15
EXPLAIN_LOCAL_EXAMPLES=3
EXPLAIN_SURROGATE_MAX_DEPTH=3
