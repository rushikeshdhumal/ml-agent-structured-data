# Azure AI Foundry project endpoint -- the project's control plane, not a model
# inference endpoint. Looks like:
#   https://<account>.services.ai.azure.com/api/projects/<project>
# Copy it from the Foundry portal's project Overview page. Auth is Entra
# (`az login`), not an API key: the Agents API does not accept one.
AZURE_FOUNDRY_PROJECT_ENDPOINT=

# The same account's plain Azure-OpenAI-compatible endpoint -- a different
# hostname from AZURE_FOUNDRY_PROJECT_ENDPOINT above, not derivable from it
# (e.g. https://<account>.cognitiveservices.azure.com/). Only used by
# `ds-crew-maf --evaluate` as the LLM judge for on-demand Azure AI
# Evaluation SDK evaluators; unset means --evaluate refuses to run rather
# than guessing an endpoint. Find it via:
#   az cognitiveservices account show --name <account> --resource-group <rg> \
#     --query properties.endpoint
AZURE_OPENAI_ENDPOINT=
# Deployment used as the judge model. Defaults to the same tier most
# pipeline stages already run on.
AZURE_OPENAI_JUDGE_DEPLOYMENT=ds-standard

# Management-plane coordinates for `ds-crew-maf --check-models` (deployment
# retirement/deprecation status + migration candidates). Not derivable from
# the data-plane endpoints above -- this data only exists on
# management.azure.com, scoped by subscription/resource group/location.
# The account name itself is derived from AZURE_OPENAI_ENDPOINT, no separate
# setting needed. Find these via:
#   az account show --query id
#   az cognitiveservices account show --name <account> --resource-group <rg> \
#     --query "{rg:resourceGroup, location:location}"
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=eastus

# Optional per-million-token rates for whichever deployment a Foundry stage
# uses, used only to turn the token counts the Responses API reports into an
# estimated_cost_usd figure at the end of a run. Leave BOTH unset on an unpriced
# or free-tier endpoint: with no rates configured no cost metric is reported at
# all, which is honest, whereas a hardcoded 0.00 would be a claim.
#   e.g. LLM_PRICE_PER_1M_INPUT=0.15
#        LLM_PRICE_PER_1M_OUTPUT=0.60
LLM_PRICE_PER_1M_INPUT=
LLM_PRICE_PER_1M_OUTPUT=

# HTTP tool service (ds-crew-service). Gates run creation; creating a run mints a
# per-run token that every subsequent tool call must present, so an agent holding
# one run's token cannot reach another's data. The service refuses to start
# without this rather than defaulting to an open endpoint.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_KEY=

# Absolute public URL the service is reachable at, emitted as the OpenAPI
# `servers` entry. Required by Azure AI Foundry's OpenAPI tool, which resolves
# operation paths against it -- the generated spec otherwise carries only
# relative paths and an agent cannot learn the host. Set it to whatever fronts
# the service: a dev tunnel while iterating, a Container Apps ingress once
# deployed. Leave unset for purely local use.
#   e.g. SERVICE_PUBLIC_URL=https://abc123-8000.usw2.devtunnels.ms
SERVICE_PUBLIC_URL=

# MLflow tracking backend (local, serverless SQLite store). ds-crew-service
# opens a run here at POST /runs and closes it at finalize_run -- the
# pipeline's decision record (leaderboard, chosen model, human verdict),
# distinct from ds-crew-maf's Application Insights traces (the operational
# record). See README's "Observability" section.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=structured-ml-crew

# Application Insights connection string (ds-crew-maf only). Routes the OTel
# traces agent_framework already emits (per-call spans: latency, tokens, the
# actual model version served behind each stage's deployment) to Application
# Insights, viewable there or in Foundry's own Tracing tab. Leave unset for a
# run with no App Insights resource -- spans are still created, just not
# exported anywhere, same as today.
#   e.g. APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Additionally export raw prompt/response content and tool-call arguments,
# not just metadata (token counts, durations). Off by default -- treat as
# sensitive, and avoid leaving it on against a shared App Insights resource.
ENABLE_SENSITIVE_TELEMETRY=0

# Human-in-the-loop bypass for ds-crew-maf. Leave unset/0 for real runs;
# set to 1 only for automated/unattended runs (a run started this way with no
# --verdict is recorded as NOT approved, since no human actually reviewed it).
AUTO_APPROVE=0

# Guardrail / budget caps
MAX_HPO_TRIALS=100
MAX_HPO_TIMEOUT_S=1800
NEAR_PERFECT_THRESHOLD=0.995
RANDOM_SEED=42

# Ensembling: hard cap on distinct member models (diminishing returns/rising
# weight-overfit risk beyond ~5 diverse tabular learners), the Optuna trial
# budget for weight optimization (cheap -- scores cached out-of-fold
# predictions, not refit models), and the minimum CV-metric margin an
# ensemble must beat the best single model by to be recommended over it.
MAX_ENSEMBLE_MEMBERS=5
ENSEMBLE_WEIGHT_TRIALS=60
MIN_ENSEMBLE_IMPROVEMENT=0.0

# Explainability: rows sampled from X_test before SHAP/permutation scoring,
# permutation-importance repeats (higher = tighter std, linearly more compute),
# how many engineered features are reported in detail, how many example rows
# per bucket (confident-correct / confident-wrong / most-uncertain) get a local
# explanation, and the depth of the surrogate decision tree whose fidelity
# tells you whether a simple story actually captures the model.
EXPLAIN_MAX_ROWS=500
EXPLAIN_PERMUTATION_REPEATS=10
EXPLAIN_TOP_K_FEATURES=15
EXPLAIN_LOCAL_EXAMPLES=3
EXPLAIN_SURROGATE_MAX_DEPTH=3
