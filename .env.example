# LLM (provider-agnostic via CrewAI's native provider routing). Examples:
#   MODEL=gpt-4o                 (requires OPENAI_API_KEY)
#   MODEL=anthropic/claude-sonnet-4-5-20250929   (requires ANTHROPIC_API_KEY)
#   MODEL=ollama/llama3          (requires a local Ollama server)
MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# For any OpenAI-compatible endpoint that isn't one of CrewAI's built-in named
# providers (e.g. NVIDIA's free NIM endpoints at build.nvidia.com), set
# LLM_BASE_URL + LLM_API_KEY instead -- crew.py then routes through CrewAI's
# native custom_openai path with the model id passed through unchanged. Example
# for NVIDIA's "z-ai/glm-5.2" model on the free tier (40 req/min):
#   MODEL=z-ai/glm-5.2
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_API_KEY=nvapi-...
#   MAX_RPM=35
LLM_BASE_URL=
LLM_API_KEY=

# Caps aggregate LLM calls/minute across the whole crew run (stay under a
# provider's rate limit). Leave unset for no cap.
MAX_RPM=

# MLflow tracking backend (local, serverless SQLite store)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=structured-ml-crew

# Human-in-the-loop bypass. Leave unset/0 for real runs; set to 1 only for
# automated/CI/headless runs. Every auto-approved run is tagged in MLflow.
AUTO_APPROVE=0

# Guardrail / budget caps
MAX_HPO_TRIALS=100
MAX_HPO_TIMEOUT_S=1800
NEAR_PERFECT_THRESHOLD=0.995
RANDOM_SEED=42
